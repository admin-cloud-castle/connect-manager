{
    "name": "cloud-castle/connect-manager",
    "description": "Унифицированный менеджер сетевых соединений PHP 8.1+: OSI-реестр, TCP/UDP/TLS/Unix, HTTP/SSH/SFTP, sync/async (Fibers), пул, SSRF-guard.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "php",
        "php8",
        "library",
        "cloudcastle",
        "connect-manager",
        "networking",
        "sockets",
        "tcp",
        "udp",
        "tls",
        "ssh",
        "http",
        "async",
        "osi",
        "protocols",
        "connection-pool",
        "stream",
        "psr"
    ],
    "authors": [
        {
            "name": "CloudCastle",
            "email": "admin.cloudcastle@gmail.com"
        }
    ],
    "homepage": "https://admin-cloud-castle.github.io/connect-manager/",
    "support": {
        "issues": "https://github.com/admin-cloud-castle/connect-manager/issues",
        "source": "https://github.com/admin-cloud-castle/connect-manager",
        "docs": "https://admin-cloud-castle.github.io/connect-manager/",
        "security": "https://github.com/admin-cloud-castle/connect-manager/security/advisories/new"
    },
    "require": {
        "php": ">=8.1",
        "ext-gmp": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "amphp/socket": "^2.3",
        "clue/socket-raw": "^1.6",
        "deptrac/deptrac": "^2.0",
        "ergebnis/composer-normalize": "^2.45",
        "friendsofphp/php-cs-fixer": "^3.68",
        "guzzlehttp/guzzle": "^7.9",
        "icanhazstring/composer-unused": "^0.9",
        "infection/infection": "^0.28.1",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpdocumentor/shim": "^3.5",
        "phpmd/phpmd": "^2.15",
        "phpseclib/phpseclib": "^3.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5",
        "psalm/plugin-phpunit": "^0.19",
        "react/socket": "^1.16",
        "rector/rector": "^2.0",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^3.11",
        "vimeo/psalm": "^6.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "CloudCastle\\ConnectManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CloudCastle\\ConnectManager\\Tests\\": "tests/",
            "CloudCastle\\ConnectManager\\Tools\\": "tools/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "phpdocumentor/shim": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "scripts": {
        "check": "@ci",
        "ci": [
            "@ci:linters",
            "@ci:static-analysis",
            "@ci:tests",
            "@ci:meta"
        ],
        "ci:linters": [
            "parallel-lint src tests tools",
            "php-cs-fixer fix --dry-run --diff",
            "phpcs"
        ],
        "ci:meta": [
            "composer normalize --dry-run",
            "composer audit",
            "composer-unused"
        ],
        "ci:static-analysis": [
            "phpstan analyse --memory-limit=512M",
            "psalm --no-cache",
            "phpmd src,tests text phpmd.xml",
            "deptrac analyse",
            "rector process --dry-run"
        ],
        "ci:tests": [
            "@test:coverage",
            "@test:mutation"
        ],
        "coverage-check": "php tools/coverage-check.php var/coverage/clover.xml",
        "docs:benchmark": "php tools/benchmark-competitors.php",
        "docs:build": "phpdoc run --config=phpdoc.dist.xml --force --no-interaction",
        "docs:check": "phpdocumentor --version",
        "docs:comparison": [
            "@docs:benchmark",
            "php tools/aggregate-comparison-json.php",
            "php tools/generate-comparison-docs.php"
        ],
        "docs:features": "php tools/generate-features-docs.php",
        "docs:sync": [
            "@docs:thresholds",
            "@docs:features",
            "@docs:comparison"
        ],
        "docs:thresholds": "php tools/generate-threshold-docs.php",
        "fix": [
            "php-cs-fixer fix",
            "rector process"
        ],
        "test": "phpunit",
        "test:comparison": "phpunit --testsuite comparison",
        "test:coverage": [
            "@php -d memory_limit=512M vendor/bin/phpunit --coverage-clover=var/coverage/clover.xml --coverage-text",
            "@php tools/coverage-check.php var/coverage/clover.xml"
        ],
        "test:integration": "phpunit --testsuite integration",
        "test:load": "phpunit --testsuite load",
        "test:mutation": [
            "Composer\\Config::disableProcessTimeout",
            "php -d memory_limit=3G vendor/bin/infection --configuration=infection.json.dist --threads=max --show-mutations --only-covered"
        ],
        "test:performance": "phpunit --testsuite performance",
        "test:security": "phpunit --testsuite security",
        "test:unit": "phpunit --testsuite unit"
    },
    "scripts-descriptions": {
        "ci": "Полный локальный пайплайн качества (как CI Quality)",
        "docs:build": "Генерация API-документации phpDocumentor для GitHub Pages",
        "docs:comparison": "Бенчмарки vs аналоги + таблицы BENCH/SECURITY",
        "docs:sync": "Пересборка авто-блоков FEATURES/THRESHOLDS/BENCH/SECURITY",
        "test:comparison": "Сравнительные тесты со всеми аналогами",
        "test:coverage": "Тесты с покрытием и порогом per-file",
        "test:mutation": "Infection MSI"
    }
}
