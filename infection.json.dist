{
    "source": {
        "directories": ["src"],
        "excludes": [
            "Driver/Ssh",
            "Driver/Http",
            "Driver/StreamOpener.php",
            "Driver/ConnectionFactory.php",
            "Driver/TransportResolver.php",
            "Contract/ConnectionOptions.php",
            "Security/PhpDnsResolver.php",
            "Async/FiberAsyncRuntime.php",
            "Async/NativeStreamSelector.php"
        ]
    },
    "timeout": 30,
    "logs": {
        "text": "var/infection/infection.log",
        "html": "var/infection/infection.html",
        "summary": "var/infection/summary.log",
        "json": "var/infection/infection.json"
    },
    "minMsi": 100,
    "minCoveredMsi": 100,
    "mutators": {
        "@default": true
    }
}
